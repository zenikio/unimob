{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"],
		"paths": {
			"$lib": ["./src/lib", "./src/lib/index.ts"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts", "drizzle.config.ts"],
	"exclude": [".svelte-kit", "node_modules"]
}
