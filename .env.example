# Only needed for `npm run db:studio` (Drizzle Studio on the remote D1).
# Everything else (dev, build) works without any env file.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Optional: login is off unless ALL of these are set (see docs/sorcery.md, "Auth").
# In production set them as Worker secrets: `npx wrangler secret put <NAME>`.
ORIGIN=""
BETTER_AUTH_URL=""
# 32+ random characters: https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
